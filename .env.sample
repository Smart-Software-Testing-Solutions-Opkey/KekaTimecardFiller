# Sample .env for KekaTimecardFiller
# Replace values with your actual credentials and details

KEKA_BEARER_TOKEN=your_bearer_token_here
KEKA_EMPLOYEE_ID=your_employee_id_here
KEKA_HOLIDAYS=YYYY-MM-DD,YYYY-MM-DD  # Comma-separated list of holidays (leave blank if none)
KEKA_MONTH=2  # Month as a number (e.g., 2 for February)
KEKA_YEAR=2026  # Year as a 4-digit number
